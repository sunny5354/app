    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.16",
    "@types/i18next": "^13.0.0",
    "@types/react-native-simple-radio-button": "^2.7.4",
    "@types/react-navigation": "^3.4.0",
